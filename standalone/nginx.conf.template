# เสิร์ฟไฟล์สถิตของเว็บแอป (รันในเบราว์เซอร์ทั้งหมด) — ${PORT} ถูกแทนค่าตอนเริ่มคอนเทนเนอร์
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # หน้าเว็บ: ตรวจเวอร์ชันใหม่ทุกครั้ง
    location = / { add_header Cache-Control "no-cache"; add_header X-Content-Type-Options nosniff always; try_files /index.html =404; }
    location = /index.html { add_header Cache-Control "no-cache"; add_header X-Content-Type-Options nosniff always; }

    # โมเดลและ wasm ขนาดใหญ่ ไม่เปลี่ยนบ่อย: แคชในเบราว์เซอร์ไว้ ครั้งต่อไปเปิดเร็ว
    location ~* \.(txt|wasm)$ {
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options nosniff always;
    }

    # ตอบ health check ทั้งพาธใหม่และพาธเดิมของเวอร์ชันเซิร์ฟเวอร์ (/api/health) เพื่อไม่ต้องแก้ตั้งค่าบน Render
    location ~ ^/(healthz|api/health)$ { access_log off; default_type text/plain; return 200 "ok\n"; }
    location / { try_files $uri =404; }
}
